#: src/adjust.c:37
msgid "Quick adjustments (non-destructive)..."
msgstr "Szybka korekta (nieniszcząca)..."

#: src/adjust.c:40
msgid "Add editable exposure, white balance and tone filters"
msgstr "Dodaj edytowalne filtry ekspozycji, balansu bieli i tonów"

#: src/adjust.c:41
msgid "Adds GEGL filters as non-destructive layer effects: exposure, colour temperature, shadows/highlights, contrast, saturation and optionally empty Levels and Curves.  Each one stays editable later."
msgstr "Dodaje filtry GEGL jako nieniszczące efekty warstwy: ekspozycję, temperaturę barwową, cienie/światła, kontrast, nasycenie oraz opcjonalnie neutralne Poziomy i Krzywe. Każdy z nich można później edytować."

#: src/adjust.c:49 src/settings.c:190
msgid "Exposure (EV)"
msgstr "Ekspozycja (EV)"

